# Copy to .env.local (the dev server reads .env.local, never .env.production). To develop against the deployed API instead of a
# local one, set NEXT_PUBLIC_API_URL to https://notes-and-papers-backend.onrender.com/api/v1.

# --- Public (compiled into the client bundle) -------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Base URL of the FastAPI backend INCLUDING the /api/v1 prefix
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Local development only: shows "Developer login" (needs DEV_AUTH=true in the backend .env). Ignored in production builds.
NEXT_PUBLIC_DEV_AUTH=false

# --- Server-only (never prefix with NEXT_PUBLIC_) ------------------------------------------
# Must equal REVALIDATE_SECRET in the backend: it sends this in the x-revalidate-secret header to POST /api/revalidate
REVALIDATE_SECRET=
# Must equal INDEXNOW_KEY in the backend: served at /indexnow-key.txt
INDEXNOW_KEY=

# --- Optional public contact details (shown in the footer and on /contact as clickable mailto:/tel: links) ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
