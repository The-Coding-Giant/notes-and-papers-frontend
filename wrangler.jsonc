{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "notes-and-papers",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Lets the worker call itself (used by the adapter for ISR revalidation).
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "notes-and-papers"
		}
	],
	// Page cache: one KV namespace used by both bindings. Created with:
	//   npx wrangler kv namespace create NEXT_TAG_CACHE_KV
	"kv_namespaces": [
		{ "binding": "NEXT_TAG_CACHE_KV", "id": "d642f541c5dc4c8a9c8ea3f1747bb1de" },
		{ "binding": "NEXT_INC_CACHE_KV", "id": "d642f541c5dc4c8a9c8ea3f1747bb1de" }
	],
	// Variables and secrets set in the Cloudflare dashboard (INDEXNOW_KEY, REVALIDATE_SECRET) survive every deploy.
	"keep_vars": true,
	"observability": {
		"enabled": true
	}
	// Secrets (never put these here): npx wrangler secret put REVALIDATE_SECRET / INDEXNOW_KEY
	// Public settings (NEXT_PUBLIC_*) are baked in at build time: see .env.production.example
}